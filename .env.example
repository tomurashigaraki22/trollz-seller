NEXT_PUBLIC_API_BASE_URL=https://api.trollzstore.com.ng

# Server-only database connection. Never prefix these with NEXT_PUBLIC_.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trollz_app
DB_PASSWORD=replace-with-a-secret
DB_NAME=trollzv3

# At least 32 characters. Generate a new value for each environment.
ADMIN_SESSION_PASSWORD=replace-with-a-long-random-secret
